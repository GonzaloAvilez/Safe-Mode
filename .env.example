# Copy to .env.local and fill in the values below.
#
# NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY don't need
# a value here for plain `npm run dev` — `predev` starts a local Supabase/Postgres stack and
# points the app at it automatically (see scripts/dev-local-setup.sh). Only fill these in if
# you're running `npm run dev:cloud` against the real shared project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# These are real, and cost real money per use — get your own, or ask for a scoped test key.
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any values you choose locally; only matter for admin-login/session/cron testing.
CRON_SECRET=
SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Hashes return keys (src/lib/identity-keys.ts), at least 32 characters. Plain `npm run dev`
# sets a local one for you. For `npm run dev:cloud` it must be the real value from Vercel:
# the same one in Production and Preview, since both use the same database, and it can never
# change (every existing key stops working). Generate it once with `openssl rand -base64 32`.
RETURN_KEY_HASH_SECRET=
